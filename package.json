{
  "name": "qabrains-automation-playwright-ts",
  "version": "1.0.0",
  "description": "QA Brains Automation - TypeScript + Playwright + Cucumber",
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "cucumber-js",
    "test:smoke": "npm run build && cucumber-js --tags @smoke",
    "test:regression": "npm run build && cucumber-js --tags @regression",
    "test:login": "npm run build && cucumber-js --tags @Login",
    "test:logout": "npm run build && cucumber-js --tags @Logout",
    "test:registration": "npm run build && cucumber-js --tags @Registration",
    "test:cart": "npm run build && cucumber-js --tags @Cart"
  },
  "dependencies": {
    "@playwright/test": "^1.53.0",
    "playwright": "^1.53.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "dotenv": "^16.4.0"
  }
}
